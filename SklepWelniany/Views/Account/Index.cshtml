@model SklepWelniany.Models.AccountViewModel
@{
    ViewData["Title"] = "Moje Konto";
}

<div class="container">
    <h2 class="my-4">Moje Konto</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    Historia Zamówień
                </div>
                <div class="card-body">
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Nr Zamówienia</th>
                                        <th>Data</th>
                                        <th>Produkty</th>
                                        <th>Akcje</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td>#@order.Id</td>
                                            <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <div>@item.Product.Name (x @item.Quantity)</div>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">Szczegóły</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Nie masz jeszcze żadnych zamówień.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Zacznij zakupy</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    Zmiana Hasła
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="ChangePassword.OldPassword"></label>
                            <input asp-for="ChangePassword.OldPassword" class="form-control" />
                            <span asp-validation-for="ChangePassword.OldPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ChangePassword.NewPassword"></label>
                            <input asp-for="ChangePassword.NewPassword" class="form-control" />
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ChangePassword.ConfirmPassword"></label>
                            <input asp-for="ChangePassword.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">Zmień hasło</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>