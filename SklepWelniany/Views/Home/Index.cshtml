@model ProductDisplayModel
@{

}

<div class="my-2 mt-4">
    <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
    <div class="col-12">
        <label class="visually-hidden" for="typeId">Type</label>
        <select class="form-select" id="typeId" name="typeId">
            <option selected>Kategoria</option>
            @foreach(var type in Model.Types)
            {
                    <option selected="@(type.Id == Model.TypeId)" value="@type.Id">@type.ProductType</option>
            }
        </select>
    </div>

    <div class="col-12">
            <label class="visually-hidden" for="sterm">Search by Product</label>
        <div class="input-group">
            <div class="input-group-text"></div>
            <input type="text" maxlength="30" class="form-control" value="@Model.STerm" id="sterm" name="sterm" placeholder="Search by Product">
        </div>
    </div>

  <div class="col-12">
    <button type="submit" class="btn btn-primary">Search</button>
    <a href="/Home/Index" class="btn btn-dark">Reset</a>
  </div>
</form>
</div>



<div class="w-100 mt-4 d-flex flex-wrap ">
    @foreach (var product in Model.Products){
    <div class="card mx-2 mb-4" style="width: 16rem;">
            @if (string.IsNullOrEmpty(product.Image))
            {
                <img style="width:100%;height:300px" src="/images/noimage.jpg" class="card-img-top" alt="..." />
            }
            else
            {
                <img style="width:100%;height:300px" src="/images/@product.Image" class="card-img-top" alt="..." />
            }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@product.ProductName</h5>
                <div class="addcartbutton mt-auto">
                <p class="card-text">
                    <b>Cena: </b>@product.Price zł <br />
                    <b>Kategoria: </b> @product.TypeName
                </p>
                     <a onclick="add(@product.Id)" class="btn btn-primary">Add to cart</a>
                </div>
        </div>
    </div>
    }
</div>

@section Scripts{
    <script>
        async function add(productId){
            var usernameEl = document.getElementById("username");

            if(usernameEl==null){
                var actionUrl = `/Cart/AddItem?productId=${productId}&redirect=1`;
                window.location.href = `/Identity/Account/Login?ReturnUrl=${encodeURIComponent(actionUrl)}`;
                return;
            }

            try{
                var response = await fetch(`/Cart/AddItem?productId=${productId}`);
                if(response.status == 200){
                    loadCartCount();
                    
                }
            }
            catch(err){
                console.log(err);
            }
        }
    </script>
}
