@model IEnumerable<Product>
@{
}

<h2>Produkty</h2>

<a asp-action="AddProduct" asp-controller="Product" class="btn btn-primary">Dodaj więcej</a>

@if (Model != null && Model.Any())
{
    <table class="table table-striped my-2">
        <thead>
            <tr>
                <th>Image</th>
                <th>Product</th>
                <th>Type</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        @if (string.IsNullOrWhiteSpace(product.Image))
                        {
                            <img style="width:150px; height:150px; object-fit: cover;" src="/images/noimage.jpg" class="card-img-top" alt="brak zdjęcia" />
                        }
                        else
                        {
                            <img style="width:150px; height:150px; object-fit: cover;" src="/images/@product.Image" class="card-img-top" alt="@product.ProductName" />
                        }
                    </td>
                    <td>@product.ProductName</td>

                    <td>@product.Type?.ProductType</td>

                    <td>@product.Price zł</td>
                    <td>
                        <a asp-action="UpdateProduct" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-success">Edytuj</a>

                        
                        <a asp-action="DeleteProduct" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-danger"
                           onclick="return confirm('Czy na pewno chcesz usunąć ten produkt?')">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3>Brak produktów do wyświetlenia.</h3>
}