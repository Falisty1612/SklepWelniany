@model SklepWelniany.Models.Cart

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

@if (Model.Items == null || !Model.Items.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img src="@(item.Product?.Images?.FirstOrDefault()?.Url ?? "/images/placeholder.png")" alt="" style="height:50px;margin-right:10px;" />
                        @item.Product?.Name
                    </td>
                    <td>@item.Product?.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Product != null ? (item.Product.Price * item.Quantity).ToString("C") : "-")</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-right">
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">Checkout</a>
    </div>
}
