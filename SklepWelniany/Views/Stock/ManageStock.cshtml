@model StockDTO
@{
}

<div style="width:50%;">
    <h2> Zarządzaj Magazynem </h2>
    <a asp-action="Index" asp-controller="Stock">Powrót</a>
    <form asp-action="ManageStock">
        <input type="hidden" asp-for="ProductId" />

        <div class="my-2">
            <label>Quantity</label>
            <input type="number" class="form-control" asp-for="Quantity" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="my-2">
            <button type="submit" class="btn btn-info">Aktualizuj</button>
        </div>

    </form>
</div>

