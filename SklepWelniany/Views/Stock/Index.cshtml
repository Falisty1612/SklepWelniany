@model IEnumerable<StockDisplayModel>
@{

}
<h2 class="mt-2">Magazyn</h2>

<form asp-action="Index" method="get" class="my-2 d-flex gap-2">
    <input type="text" name="sTerm" class="form-control w-25" placeholder="Szukaj po produkcie"/>
    <button type="submit" class="btn btn-primary">Szukaj</button>
    <a asp-action="Index" asp-controller="Stock" class="btn btn-primary">Clear</a>
</form>

<table class="table table-striped table-hover">
    <tr>
        <th>Product</th>
        <th>Stock</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.Quantity</td>
            <td>
                <a asp-action="ManageStock" asp-controller="Stock" 
                asp-route-productId="@item.ProductId" class="btn btn-info">Aktualizuj Magazyn</a>
            </td>
        </tr>
    }

            
</table>