@model IEnumerable<Order>
@{
}
<div style="width:100%" class="mt-3">
    <a href="/Identity/Account/Manage" class="my-3 btn btn-dark">Powrót</a>

    <h3>My Orders</h3>
    @if (Model != null && Model.Count()>0)
    {
        <table class="table table-striped">
            <tr>
                <th>Order Date</th>
                <th>Status</th>
                <th></th>
            </tr>
            @foreach(var order in Model)
            {
                <tr>
                    <td>@order.CreateDate.ToString("dd-MM-yyyy")</td>
                    <td>@order.OrderStatus.StatusName</td>
                    @if (order.OrderDetails != null && order.OrderDetails.Count > 0)
                    {
                        <td>
                            <table class="table table-striped">
                                <tr>
                                    <th>Product</th>
                                    <th>Image</th>
                                    <th>Type</th>
                                    <th>Unit Price</th>
                                    <th>Total Price</th>
                                    <th>Action</th>
                                </tr>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <tr>
                                        <td>@item.Product.ProductName</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(item.Product.Image))
                                            {
                                                <img src="/images/noimage.jpg" style="width:50%;height:50%" />
                                            }
                                            else
                                            {
                                                <img src="/images/@item.Product.Image" style="width:100%;height:300px" />
                                            }
                                        </td>
                                        <td>@item.Product.TypeName</td>
                                        <td>@(item.Product.Price) zł x @item.Quantity</td>
                                        <td>@(item.Product.Price* item.Quantity) zł</td>
                                        <td>
                                            <a class="btn btn-info" href="/Cart/AddItem?productId=@item.ProductId&&redirect=1">+</a>
                                            <a class="btn btn-info" href="/Cart/RemoveItem?productId=@item.ProductId">-</a>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </td>
                    }

                </tr>
            }
        </table>

        
    }
    else
    {
        <h3>No orders</h3>
    }
</div>

