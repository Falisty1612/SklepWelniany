@page
@model SklepWelniany.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.Login"></label>
                <input asp-for="Input.Login" class="form-control" placeholder="Username or Email" />
                <span asp-validation-for="Input.Login" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <div class="input-group">
                    <input asp-for="Input.Password" id="Password" type="password" class="form-control" placeholder="Password" />
                    <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                        Poka¿
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group form-check">
                <input asp-for="Input.RememberMe" type="checkbox" class="form-check-input" /> Remember me
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <br />
            <button type="submit" class="btn btn-primary">Log in</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var toggle = document.getElementById('togglePassword');
            var pwd = document.getElementById('Password');
            if (toggle && pwd) {
                toggle.addEventListener('click', function () {
                    var isText = pwd.type === 'text';
                    pwd.type = isText ? 'password' : 'text';
                    toggle.textContent = isText ? 'Poka¿' : 'Ukryj';
                });
            }
        })();
    </script>
}
